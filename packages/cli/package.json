    "test": "node ../../scripts/test.mjs cli"
  },
  "dependencies": {
    "@openaide/api": "*",
    "@openaide/config": "*",
    "@openaide/core": "*",
    "@openaide/llm": "*",
    "@openaide/memory": "*",
    "@openaide/plugins": "*",
    "@openaide/tools": "*",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0"
  }

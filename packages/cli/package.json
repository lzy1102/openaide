{
  "name": "@openaide/cli",
  "version": "0.3.0",
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "bin": {
    "openaide": "./src/main.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",

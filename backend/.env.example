# OpenAIDE 服务器环境变量配置
# 复制此文件为 .env 并填写实际值

# 服务端口
PORT=19375

# JWT 密钥（生产环境必须设置，否则每次重启自动生成新密钥导致已登录用户失效）
JWT_SECRET=change-me-to-a-random-secret

# 数据主目录
OPENAIDE_HOME=/opt/openaide

# 配置文件路径（可选，默认使用 OPENAIDE_HOME/config.json）
# OPENAIDE_CONFIG=/opt/openaide/config.json

# 前端静态文件目录（可选）
# OPENAIDE_FRONTEND_DIR=/usr/share/openaide/frontend

# 时区
TZ=Asia/Shanghai

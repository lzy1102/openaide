{
  "llm": {
    "default_provider": "deepseek",
    "providers": [
      {
        "name": "deepseek",
        "type": "openai",
        "base_url": "https://api.deepseek.com/v1",
        "api_key": "sk-请替换为你的API Key",
        "default_model": "deepseek-v4-pro",
        "enabled": true
      }
    ]
  },
  "memory": {
    "data_dir": "~/.openaide/data/memory"
  },
  "kernel": {
    "max_rounds": 10
  },
  "storage": {
    "data_dir": "~/.openaide/data"
  },
  "browser": {
    "enabled": false
  },
  "log": {
    "level": "info"
  }
}

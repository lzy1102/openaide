{
  "home_dir": "/opt/openaide",
  "storage": {
    "cache": {
      "type": "ledis",
      "default_expiration": 3600,
      "cleanup_interval": 600,
      "data_dir": "/opt/openaide/data/ledis"
    },
    "db": {
      "type": "sqlite",
      "uri": "/opt/openaide/data/db/openaide.db"
    },
    "vector_store": {
      "type": "hnsw",
      "data_dir": "/opt/openaide/data/vectors"
    }
  },
  "models": [
    {
      "name": "deepseek-chat",
      "description": "DeepSeek Chat",
      "type": "llm",
      "provider": "deepseek",
      "api_key": "your-deepseek-api-key-here",
      "base_url": "https://api.deepseek.com",
      "config": {
        "model": "deepseek-chat",
        "timeout": 60
      },
      "status": "enabled"
    },
    {
      "name": "gpt-4",
      "description": "OpenAI GPT-4",
      "type": "llm",
      "provider": "openai",
      "api_key": "sk-your-openai-api-key-here",
      "base_url": "https://api.openai.com/v1",
      "config": {
        "timeout": 60,
        "max_retries": 3,
        "retry_delay": 1000
      },
      "status": "enabled"
    },
    {
      "name": "glm-5",
      "description": "智谱 GLM-5",
      "type": "llm",
      "provider": "glm",
      "api_key": "your-glm-api-key-id.secret",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "config": {
        "model": "glm-5",
        "timeout": 60
      },
      "status": "enabled"
    }
  ],
  "feishu": {
    "enabled": false,
    "app_id": "",
    "app_secret": "",
    "default_model": "deepseek-chat",
    "system_prompt": "",
    "stream_interval": 1000
  },
  "voice": {
    "enabled": false,
    "whisper_api": "",
    "whisper_key": "",
    "tts_api": "",
    "tts_key": "",
    "tts_voice": "alloy",
    "default_lang": "zh"
  },
  "sandbox": {
    "enabled": false,
    "docker_image": "openaide-sandbox:latest",
    "timeout": 60,
    "max_memory_mb": 256
  },
  "embedding": {
    "enabled": false,
    "provider": "openai",
    "api_key": "",
    "model": "text-embedding-3-small",
    "base_url": ""
  },
  "context": {
    "compression_enabled": true,
    "compression_mode": "balanced",
    "max_tokens": 8000,
    "keep_last_n": 4,
    "preserve_tool_calls": true,
    "fallback_to_summary": true
  },
  "activity_timeout": "30m"
}

[Unit]
Description=OpenAIDE AI Assistant
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openaide
ExecStart=/opt/openaide/bin/openaide-server -config /opt/openaide/config.json
Restart=always
RestartSec=5
StandardOutput=append:/opt/openaide/logs/server.log
StandardError=append:/opt/openaide/logs/server.log

[Install]
WantedBy=multi-user.target

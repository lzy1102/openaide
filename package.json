{
  "name": "openaide",
  "version": "0.3.0",
  "private": true,
  "description": "AI Agent kernel platform — TypeScript, plugin-driven, everything is a plugin",
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "tsx packages/cli/src/main.ts",
    "dev:repl": "tsx packages/cli/src/main.ts repl",
    "dev:serve": "tsx packages/cli/src/main.ts serve",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/test.mjs && npm run test --workspace frontend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.61.1",
    "react-devtools-core": "^4.28.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "react": "18.3.1",
    "@types/react": "^18.3.0"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}
